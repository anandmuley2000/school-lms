# Railway backend service variables. Replace placeholders with Railway references/values.
SPRING_PROFILES_ACTIVE=production
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_SSL_MODE=REQUIRED
JWT_SECRET=GENERATE-A-UNIQUE-RANDOM-SECRET-AT-LEAST-32-CHARACTERS
CORS_ALLOWED_ORIGINS=https://courteous-truth-production-470f.up.railway.app
DEMO_DATA_ENABLED=false
FILE_UPLOAD_PATH=/app/uploads
