# Copy these keys into the Render backend service Environment page.
SPRING_PROFILES_ACTIVE=production
DB_HOST=YOUR-MYSQL-HOST
DB_PORT=3306
DB_NAME=YOUR-MYSQL-DATABASE
DB_USERNAME=YOUR-MYSQL-USERNAME
DB_PASSWORD=SET-AS-A-SECRET
DB_SSL_MODE=REQUIRED
JWT_SECRET=GENERATE-A-UNIQUE-RANDOM-SECRET-AT-LEAST-32-CHARACTERS
# Initially allow the Capacitor origin; add the real Static Site origin after it exists.
CORS_ALLOWED_ORIGINS=https://localhost
DEMO_RESET_ENABLED=false
JWT_EXPIRATION_MS=86400000
FILE_UPLOAD_PATH=/app/uploads
# Render sets PORT automatically. Do not add a fixed PORT value.
