# Production deployment template. Copy these values into the backend host's secret/configuration panel.
# Railway backend service variables (set in Railway; never commit real values).
SPRING_PROFILES_ACTIVE=production
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR-RAILWAY-MYSQL-HOST:3306/YOUR_DATABASE?serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=YOUR-RAILWAY-MYSQL-USERNAME
SPRING_DATASOURCE_PASSWORD=SET_IN_RAILWAY_VARIABLES
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
JWT_SECRET=GENERATE-A-UNIQUE-RANDOM-SECRET-AT-LEAST-32-CHARACTERS
CORS_ALLOWED_ORIGINS=https://YOUR-REAL-ADMIN-DOMAIN
JWT_EXPIRATION_MS=86400000
FILE_UPLOAD_PATH=./uploads

# Admin build-time variable. Replace with the real Railway backend URL before building.
VITE_API_BASE_URL=https://YOUR-REAL-RAILWAY-BACKEND-DOMAIN/api
